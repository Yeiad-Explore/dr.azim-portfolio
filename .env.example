# Copy to .env.local for `vercel dev`. Never commit a real key.
# In production these live in Vercel → Project → Settings → Environment Variables.

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://studynet-ai-agent.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview
CHAT_MODEL_DEPLOYMENT=chat-heavy

# --- Booking (n8n) ---------------------------------------------------------
# While N8N_BOOKING_WEBHOOK_URL is unset, /api/booking serves deterministic
# mock responses so the UI is testable. Setting it switches the mock off.
# Use the n8n TEST webhook URL first; swap to the production URL only after
# N8N_BOOKING_TOKEN is set and the workflow verifies it.
N8N_BOOKING_WEBHOOK_URL=
N8N_BOOKING_TOKEN=
